# ============================================================

# 🟢 DEFAULT (DOCKER - RECOMMENDED)

# Uses docker-compose service: pncp_postgres

# ============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=pncp_db
POSTGRES_HOST=pncp_postgres
POSTGRES_PORT=5432

# Full connection string (recommended)

DATABASE_URL=postgresql+psycopg2://postgres:postgres123@pncp_postgres:5432/pncp_db

# ============================================================

# 🔵 LOCAL DATABASE (running outside Docker)

# ============================================================

# POSTGRES_USER=myuser

# POSTGRES_PASSWORD=mypassword

# POSTGRES_DB=mydatabase

# POSTGRES_HOST=127.0.0.1

# POSTGRES_PORT=5432

# DATABASE_URL=postgresql+psycopg2://myuser:mypassword@127.0.0.1:5432/mydatabase

# ============================================================

# 🟣 CLOUD / EXTERNAL DATABASE

# ============================================================

# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ============================================================

# 🟡 OPTIONAL SETTINGS

# ============================================================

# Auto run migrations on startup

# RUN_MIGRATIONS=true
